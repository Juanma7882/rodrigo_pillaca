generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model AdminUser {
  id            String         @id @default(uuid())
  email         String         @unique
  passwordHash  String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  refreshTokens RefreshToken[]

  @@map("admin_users")
}

model RefreshToken {
  id           String    @id @default(uuid())
  adminUserId  String
  adminUser    AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  /// Hash SHA-256 del token opaco: el valor real solo vive en la cookie del navegador.
  tokenHash    String    @unique
  /// Todos los tokens de una misma sesión comparten familia (detección de reutilización).
  familyId     String
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?
  createdAt    DateTime  @default(now())

  @@index([adminUserId])
  @@index([familyId])
  @@map("refresh_tokens")
}

# Copiar a .env y completar. Nunca versionar .env.

# NODE_ENV no va acá: Vite lo leería del .env y compilaría React en modo desarrollo.
# La API asume "development" si no está definido; Docker lo define explícitamente.
LOG_LEVEL=debug

# --- Base de datos ---
POSTGRES_USER=tamila
POSTGRES_PASSWORD=cambiar-esta-clave
POSTGRES_DB=tamila
POSTGRES_PORT=5435
# Conexión desde el host (prisma, tests, API fuera de Docker).
# Dentro de Docker Compose se sobrescribe con el host "postgres" y el puerto 5432.
DATABASE_URL=postgresql://tamila:cambiar-esta-clave@localhost:5435/tamila?schema=public
DATABASE_URL_TEST=postgresql://tamila:cambiar-esta-clave@localhost:5435/tamila_test?schema=public

# --- API ---
API_PORT=3000
# Orígenes permitidos por CORS, separados por coma.
CORS_ORIGINS=http://localhost:4173,http://localhost:4174
# Número de proxies de confianza delante de la API (Caddy = 1).
TRUST_PROXY_HOPS=1

# --- JWT ---
# Generar con: openssl rand -base64 48
JWT_ACCESS_SECRET=cambiar-por-un-secreto-largo-y-aleatorio-de-al-menos-32-caracteres
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7

# --- Cloudflare Turnstile ---
# Claves de prueba oficiales (siempre pasan). En producción usar las reales.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# --- Administrador inicial (seed) ---
ADMIN_EMAIL=admin@tamila.local
ADMIN_PASSWORD=cambiar-esta-clave-admin

# --- Frontends ---
WEB_PORT=4173
ADMIN_PORT=4174
# URL de la API vista desde el servidor SSR de web (red interna de Docker).
API_INTERNAL_URL=http://api:3000

# --- Producción (docker/compose.prod.yml) ---
# Dominios servidos por Caddy. Localmente: http://localhost y http://admin.localhost
SITE_DOMAIN=http://localhost
ADMIN_DOMAIN=http://admin.localhost
HTTP_PORT=8080
HTTPS_PORT=8443
# Imágenes en GHCR (las completa el workflow de deploy).
IMAGE_PREFIX=ghcr.io/juanma7882/rodrigo_pillaca
IMAGE_TAG=local
